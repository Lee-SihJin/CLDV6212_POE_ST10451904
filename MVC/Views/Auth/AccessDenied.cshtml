@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Access Denied
                    </h3>
                </div>
                <div class="card-body py-5">
                    <div class="mb-4">
                        <i class="fas fa-lock text-danger" style="font-size: 4rem;"></i>
                    </div>

                    <h4 class="text-danger mb-3">You don't have permission to access this page.</h4>

                    <p class="text-muted mb-4">
                        You are logged in as <strong>@User.Identity.Name</strong>, but your account
                        doesn't have the required permissions to view this page.
                    </p>

                    <div class="alert alert-warning">
                        <h6 class="alert-heading">
                            <i class="fas fa-info-circle"></i> Required Permissions
                        </h6>
                        <p class="mb-0 small">
                            This page requires administrative privileges. Please contact your system
                            administrator if you believe you should have access to this resource.
                        </p>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-out-alt"></i> Login as Different User
                        </a>
                    </div>

                    <!-- Admin Contact Information -->
                    <div class="mt-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-headset"></i> Need Help?
                                </h6>
                                <p class="card-text small mb-2">
                                    Contact the system administrator for access permissions:
                                </p>
                                <ul class="list-unstyled small">
                                    <li><i class="fas fa-envelope"></i> admin@abcretailers.com</li>
                                    <li><i class="fas fa-phone"></i> (555) 123-4567</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>