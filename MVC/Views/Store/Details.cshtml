@model ABCRetailers.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}

<style>
    .btn-disabled-custom {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.ProductName"
                     style="max-height: 500px; object-fit: cover;">
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded"
                     style="height: 400px;">
                    <i class="fas fa-image fa-5x text-muted"></i>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title h2">@Model.ProductName</h1>

                    <div class="mb-3">
                        <span class="h3 text-success">@Model.Price.ToString("C")</span>
                        <span class="badge @(Model.StockAvailable > 10 ? "bg-success" : Model.StockAvailable > 0 ? "bg-warning" : "bg-danger") ms-2">
                            @if (Model.StockAvailable > 10)
                            {
                                <text>In Stock</text>
                            }
                            else if (Model.StockAvailable > 0)
                            {
                                <text>Only @Model.StockAvailable left</text>
                            }
                            else
                            {
                                <text>Out of Stock</text>
                            }
                        </span>
                    </div>

                    <p class="card-text lead">@Model.Description</p>

                    <div class="mb-4">
                        <h5>Product Details</h5>
                        <ul class="list-unstyled">
                            <li><strong>Product ID:</strong> <code>@Model.ProductId.Substring(0, 8)...</code></li>
                            <li><strong>Available Stock:</strong> <span id="availableStock">@Model.StockAvailable</span> units</li>
                            <li><strong>In Your Cart:</strong> <span id="cartQuantityDisplay">0</span> units</li>
                        </ul>
                    </div>
                    @if (Model.StockAvailable > 0)
                    {
                        if (User.Identity.IsAuthenticated)
                        {
                            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="row g-3" id="addToCartForm">
                                <input type="hidden" name="productId" value="@Model.RowKey" />
                                <input type="hidden" name="productName" value="@Model.ProductName" />
                                <input type="hidden" name="unitPrice" value="@Model.Price" />

                                <!-- Cart Quantity Info -->
                                <div class="col-12 mb-2">
                                    <div class="alert alert-info py-2" id="cartLimitAlert" style="display: none;">
                                        <i class="fas fa-info-circle"></i>
                                        <span id="cartLimitMessage">You have reached the maximum quantity for this item.</span>
                                    </div>
                                </div>

                                <div class="col-auto">
                                    <label for="quantity" class="col-form-label"><strong>Quantity:</strong></label>
                                </div>
                                <div class="col-auto">
                                    <input type="number" name="quantity" id="quantity"
                                           class="form-control" value="1" min="1"
                                           style="width: 80px;">
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-success btn-lg" id="addToCartButton">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                </div>

                                <!-- Available Stock Info -->
                                <div class="col-12 mt-2">
                                    <small class="text-muted">
                                        Maximum available to add: <span id="maxAvailable">@Model.StockAvailable</span> units
                                    </small>
                                </div>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-success w-100">
                                <i class="fas fa-cart-plus"></i> Login to Add to Cart
                            </a>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            This product is currently out of stock. Please check back later.
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-primary ms-2">
                            <i class="fas fa-shopping-cart"></i> View Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentCartQuantity = 0;
        let stockAvailable = @Model.StockAvailable;

        // Get current cart quantity and update UI
        async function updateCartQuantity() {
            try {
                const response = await fetch(`/Cart/GetProductQuantity?productId=@Model.RowKey`);
                if (response.ok) {
                    currentCartQuantity = await response.json();
                    document.getElementById('cartQuantityDisplay').textContent = currentCartQuantity;

                    // Update UI based on cart quantity
                    updateQuantityLimits();
                }
            } catch (error) {
                console.error('Error updating cart quantity:', error);
            }
        }

        // Update quantity limits and button state
        function updateQuantityLimits() {
            const quantityInput = document.getElementById('quantity');
            const addToCartButton = document.getElementById('addToCartButton');
            const cartLimitAlert = document.getElementById('cartLimitAlert');
            const maxAvailableSpan = document.getElementById('maxAvailable');
            const cartLimitMessage = document.getElementById('cartLimitMessage');

            const maxAllowed = stockAvailable - currentCartQuantity;

            // Update max available display
            maxAvailableSpan.textContent = maxAllowed;

            if (maxAllowed <= 0) {
                // Completely disable adding to cart
                quantityInput.disabled = true;
                quantityInput.value = 0;
                addToCartButton.disabled = true;
                addToCartButton.classList.add('btn-disabled-custom');
                addToCartButton.innerHTML = '<i class="fas fa-check-circle"></i> Max in Cart';

                // Show alert
                cartLimitAlert.style.display = 'block';
                cartLimitMessage.textContent = `You already have ${currentCartQuantity} items in your cart. Maximum quantity reached.`;

            } else {
                // Enable controls with limits
                quantityInput.disabled = false;
                quantityInput.max = maxAllowed;
                addToCartButton.disabled = false;
                addToCartButton.classList.remove('btn-disabled-custom');
                addToCartButton.innerHTML = '<i class="fas fa-cart-plus"></i> Add to Cart';

                // Hide alert if quantity is within limits
                cartLimitAlert.style.display = 'none';

                // Ensure current quantity doesn't exceed max allowed
                if (quantityInput.value > maxAllowed) {
                    quantityInput.value = maxAllowed;
                }

                // If quantity is 0 but maxAllowed > 0, set to 1
                if (quantityInput.value <= 0 && maxAllowed > 0) {
                    quantityInput.value = 1;
                }
            }
        }

        // Validate before form submission
        async function validateAddToCart(form) {
            const quantityInput = document.getElementById('quantity');
            const quantity = parseInt(quantityInput.value) || 0;

            if (quantity <= 0) {
                alert('Please enter a valid quantity.');
                return false;
            }

            if (currentCartQuantity + quantity > stockAvailable) {
                alert(`Cannot add ${quantity} items. You already have ${currentCartQuantity} in your cart, and only ${stockAvailable} available in stock.`);
                return false;
            }

            // Show loading state
            const button = document.getElementById('addToCartButton');
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            button.disabled = true;

            return true;
        }

        // Quantity input change handler
        function handleQuantityChange() {
            const quantityInput = document.getElementById('quantity');
            const quantity = parseInt(quantityInput.value) || 0;
            const maxAllowed = stockAvailable - currentCartQuantity;

            if (quantity > maxAllowed) {
                quantityInput.value = maxAllowed;
                alert(`You can only add ${maxAllowed} more items to your cart.`);
            }

            if (quantity < 1 && maxAllowed > 0) {
                quantityInput.value = 1;
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartQuantity();

            const quantityInput = document.getElementById('quantity');
            const addToCartForm = document.getElementById('addToCartForm');

            // Add event listeners
            quantityInput.addEventListener('change', handleQuantityChange);
            quantityInput.addEventListener('input', handleQuantityChange);

            // Add form submission handler
            addToCartForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const isValid = await validateAddToCart(this);
                if (isValid) {
                    this.submit();
                }
            });
        });
    </script>
}