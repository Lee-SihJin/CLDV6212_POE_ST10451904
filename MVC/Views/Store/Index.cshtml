@model IEnumerable<ABCRetailers.Models.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border-color: #007bff;
        }

    .product-image {
        transition: transform 0.2s;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .stock-badge {
        font-size: 0.75rem;
    }

    .btn-disabled-custom {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<div class="container mt-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6 text-primary">
                <i class="fas fa-store"></i> Welcome to Our Store
            </h1>
            <p class="lead text-muted">Discover amazing products at great prices</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-primary btn-lg position-relative">
                <i class="fas fa-shopping-cart"></i> View Cart
                <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                    0
                </span>
            </a>
        </div>
    </div>

    <!-- Search Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <input type="text"
                               name="searchTerm"
                               class="form-control"
                               placeholder="What are you looking for?"
                               value="@ViewBag.SearchTerm">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <div class="mt-3">
                    <p class="text-muted mb-0">
                        Search results for: "<strong>@ViewBag.SearchTerm</strong>"
                        <span class="ms-2">• Found @Model.Count() product(s)</span>
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- Products Grid -->
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 product-card">
                        <!-- Product Image -->
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.ProductName"
                                 style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 250px;">
                                <i class="fas fa-image fa-4x text-muted"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <!-- Product Info -->
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(product.Description.Length > 100 ? product.Description.Substring(0, 100) + "..." : product.Description)
                            </p>

                            <!-- Price and Stock -->
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="h4 text-success mb-0">@product.Price.ToString("C")</span>
                                    <span class="badge stock-badge @(product.StockAvailable > 10 ? "bg-success" : product.StockAvailable > 0 ? "bg-warning" : "bg-danger")">
                                        @if (product.StockAvailable > 10)
                                        {
                                            <text>In Stock</text>
                                        }
                                        else if (product.StockAvailable > 0)
                                        {
                                            <text>Only @product.StockAvailable left</text>
                                        }
                                        else
                                        {
                                            <text>Out of Stock</text>
                                        }
                                    </span>
                                </div>

                                <!-- Cart Quantity Display -->
                                <div class="mb-2">
                                    <small class="text-muted" id="cartQuantity-@product.RowKey" style="display: none;">
                                        <i class="fas fa-shopping-cart"></i> In your cart: <span class="fw-bold">0</span>
                                    </small>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    @if (product.StockAvailable > 0)
                                    {
                                        if (User.Identity.IsAuthenticated)
                                        {
                                            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="d-inline" id="form-@product.RowKey">
                                                <input type="hidden" name="productId" value="@product.RowKey" />
                                                <input type="hidden" name="productName" value="@product.ProductName" />
                                                <input type="hidden" name="unitPrice" value="@product.Price" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="btn btn-success btn-lg" id="addToCart-@product.RowKey">
                                                    <i class="fas fa-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="Login"
                                               asp-route-returnUrl="@Context.Request.Path"
                                               class="btn btn-success btn-lg">
                                                <i class="fas fa-cart-plus"></i> Login to Purchase
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-lg" disabled>
                                            <i class="fas fa-times-circle"></i> Out of Stock
                                        </button>
                                    }

                                    <a asp-action="Details" asp-route-id="@product.RowKey" class="btn btn-outline-primary">
                                        <i class="fas fa-info-circle"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Update cart badge count
        async function updateCartBadge() {
            try {
                const response = await fetch('/Cart/GetCartItemCount');
                if (response.ok) {
                    const count = await response.json();
                    const badge = document.getElementById('cartBadge');
                    if (count > 0) {
                        badge.textContent = count;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('Error updating cart badge:', error);
            }
        }

        // Get cart quantities for all products and update UI
        async function updateCartQuantities() {
            try {
                const response = await fetch('/Cart/GetCartProductQuantities');
                if (response.ok) {
                    const quantities = await response.json();

                    // Update quantities on product cards and disable buttons if needed
                    Object.keys(quantities).forEach(productId => {
                        const quantityElement = document.getElementById(`cartQuantity-${productId}`);
                        const addToCartButton = document.getElementById(`addToCart-${productId}`);

                        if (quantityElement) {
                            const span = quantityElement.querySelector('span');
                            if (span) {
                                span.textContent = quantities[productId];
                                quantityElement.style.display = 'block';
                            }
                        }

                        // Check if we need to disable the button
                        checkAndDisableButton(productId, quantities[productId]);
                    });
                }
            } catch (error) {
                console.error('Error updating cart quantities:', error);
            }
        }

        // Check if button should be disabled and disable it
        async function checkAndDisableButton(productId, currentCartQuantity = null) {
            try {
                // If currentCartQuantity is not provided, fetch it
                if (currentCartQuantity === null) {
                    const response = await fetch(`/Cart/GetProductStockInfo?productId=${productId}`);
                    if (response.ok) {
                        const stockInfo = await response.json();
                        currentCartQuantity = stockInfo.currentCartQuantity || 0;
                    }
                }

                const addToCartButton = document.getElementById(`addToCart-${productId}`);
                const quantityElement = document.getElementById(`cartQuantity-${productId}`);

                if (addToCartButton) {
                    const response = await fetch(`/Cart/GetProductStockInfo?productId=${productId}`);
                    if (response.ok) {
                        const stockInfo = await response.json();

                        // If cart quantity equals or exceeds stock, disable the button
                        if (currentCartQuantity >= stockInfo.stockAvailable) {
                            addToCartButton.disabled = true;
                            addToCartButton.classList.add('btn-disabled-custom');
                            addToCartButton.innerHTML = '<i class="fas fa-check-circle"></i> Max in Cart';

                            // Update the cart quantity display to show limit reached
                            if (quantityElement) {
                                quantityElement.innerHTML = `<i class="fas fa-exclamation-triangle text-warning"></i> Maximum quantity in cart`;
                                quantityElement.style.display = 'block';
                            }
                        } else {
                            addToCartButton.disabled = false;
                            addToCartButton.classList.remove('btn-disabled-custom');
                            addToCartButton.innerHTML = '<i class="fas fa-cart-plus"></i> Add to Cart';
                        }
                    }
                }
            } catch (error) {
                console.error('Error checking button state:', error);
            }
        }

        // Validate stock before adding to cart (for index page)
        async function validateStock(productId, form) {
            try {
                // Get stock info from server
                const response = await fetch(`/Cart/GetProductStockInfo?productId=${productId}`);
                if (response.ok) {
                    const stockInfo = await response.json();
                    const quantity = 1; // For index page, we're always adding 1

                    if (stockInfo.stockAvailable <= 0) {
                        alert('This product is out of stock.');
                        return false;
                    }

                    if (stockInfo.currentCartQuantity + quantity > stockInfo.stockAvailable) {
                        alert(`Cannot add to cart. You already have ${stockInfo.currentCartQuantity} in your cart, and only ${stockInfo.stockAvailable} available in stock.`);
                        return false;
                    }

                    return true;
                }
            } catch (error) {
                console.error('Error validating stock:', error);
            }

            return true; // Allow submission if validation fails (server will catch it)
        }

        // Enhanced add to cart with validation
        async function addToCartWithValidation(productId, form) {
            const isValid = await validateStock(productId, form);
            if (isValid) {
                // Show loading state
                const button = form.querySelector('button[type="submit"]');
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
                button.disabled = true;

                // Submit the form
                form.submit();

                // After submission, the page will reload and the button will be updated
                return true;
            }
            return false; // Prevent form submission
        }

        // Update all product buttons on page load
        async function updateAllProductButtons() {
            try {
                const response = await fetch('/Cart/GetCartProductQuantities');
                if (response.ok) {
                    const quantities = await response.json();

                    // For each product on the page, check and update button state
                    @foreach (var product in Model)
                    {
                            <text>
                            checkAndDisableButton('@product.RowKey', quantities['@product.RowKey'] || 0);
                            </text>
                    }
                }
            } catch (error) {
                console.error('Error updating product buttons:', error);
            }
        }

        // Update cart badge and quantities on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartBadge();
            updateCartQuantities();
            updateAllProductButtons();
        });
    </script>
}