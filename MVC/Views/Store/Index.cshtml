@model IEnumerable<ABCRetailers.Models.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border-color: #007bff;
        }

    .product-image {
        transition: transform 0.2s;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .stock-badge {
        font-size: 0.75rem;
    }
</style>

<div class="container mt-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6 text-primary">
                <i class="fas fa-store"></i> Welcome to Our Store
            </h1>
            <p class="lead text-muted">Discover amazing products at great prices</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-primary btn-lg position-relative">
                <i class="fas fa-shopping-cart"></i> View Cart
                <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                    0
                </span>
            </a>
        </div>
    </div>

    <!-- Search Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <input type="text"
                               name="searchTerm"
                               class="form-control"
                               placeholder="What are you looking for?"
                               value="@ViewBag.SearchTerm">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <div class="mt-3">
                    <p class="text-muted mb-0">
                        Search results for: "<strong>@ViewBag.SearchTerm</strong>"
                        <span class="ms-2">• Found @Model.Count() product(s)</span>
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- Products Grid -->
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 product-card">
                        <!-- Product Image -->
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.ProductName"
                                 style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 250px;">
                                <i class="fas fa-image fa-4x text-muted"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <!-- Product Info -->
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(product.Description.Length > 100 ? product.Description.Substring(0, 100) + "..." : product.Description)
                            </p>

                            <!-- Price and Stock -->
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="h4 text-success mb-0">@product.Price.ToString("C")</span>
                                    <span class="badge stock-badge @(product.StockAvailable > 10 ? "bg-success" : product.StockAvailable > 0 ? "bg-warning" : "bg-danger")">
                                        @if (product.StockAvailable > 10)
                                        {
                                            <text>In Stock</text>
                                        }
                                        else if (product.StockAvailable > 0)
                                        {
                                            <text>Only @product.StockAvailable left</text>
                                        }
                                        else
                                        {
                                            <text>Out of Stock</text>
                                        }
                                    </span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    @if (product.StockAvailable > 0)
                                    {
                                        if (User.Identity.IsAuthenticated)
                                        {
                                            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="d-inline">
                                                <input type="hidden" name="productId" value="@product.RowKey" />
                                                <input type="hidden" name="productName" value="@product.ProductName" />
                                                <input type="hidden" name="unitPrice" value="@product.Price" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="btn btn-success btn-lg">
                                                    <i class="fas fa-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="Login"
                                               asp-route-returnUrl="@Context.Request.Path"
                                               class="btn btn-success btn-lg">
                                                <i class="fas fa-cart-plus"></i> Login to Purchase
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-lg" disabled>
                                            <i class="fas fa-times-circle"></i> Out of Stock
                                        </button>
                                    }

                                    <a asp-action="Details" asp-route-id="@product.RowKey" class="btn btn-outline-primary">
                                        <i class="fas fa-info-circle"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-search fa-4x text-muted mb-4"></i>
            <h3 class="text-muted">No products found</h3>
            <p class="text-muted lead">
                @(!string.IsNullOrEmpty(ViewBag.SearchTerm) ? "Try adjusting your search terms or browse all products." : "We're restocking our inventory. Please check back soon!")
            </p>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fas fa-list"></i> Browse All Products
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Update cart badge count
        async function updateCartBadge() {
            try {
                const response = await fetch('/Cart/GetCartItemCount');
                if (response.ok) {
                    const count = await response.json();
                    const badge = document.getElementById('cartBadge');
                    if (count > 0) {
                        badge.textContent = count;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('Error updating cart badge:', error);
            }
        }

        // Update cart badge on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartBadge();
        });
    </script>
}