@* Views/CustomerAccount/MyAccount.cshtml *@
@model ABCRetailers.Models.ViewModels.CustomerInfoViewModel
@{
    ViewData["Title"] = "My Account";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <!-- Profile Summary Card -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-circle"></i> Profile Summary
                    </h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-user fa-3x text-primary"></i>
                    </div>
                    <h4>@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">@@@Model.Username</p>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="fas fa-chart-bar"></i> Quick Stats</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border rounded p-2">
                                <h4 class="text-primary mb-0">@Model.TotalOrders</h4>
                                <small class="text-muted">Total Orders</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="border rounded p-2">
                                <h4 class="text-success mb-0">@Model.TotalSpent.ToString("C")</h4>
                                <small class="text-muted">Total Spent</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="border rounded p-2">
                                <h4 class="text-warning mb-0">@Model.PendingOrders</h4>
                                <small class="text-muted">Pending Orders</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <!-- Account Details -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle"></i> Account Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Username:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.Username
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Email Address:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.Email
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Full Name:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.FirstName @Model.LastName
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Phone Number:</strong>
                        </div>
                        <div class="col-sm-8">
                            @(Model.PhoneNumber ?? "Not provided")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Shipping Address:</strong>
                        </div>
                        <div class="col-sm-8">
                            @(Model.ShippingAddress ?? "Not provided")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Date of Birth:</strong>
                        </div>
                        <div class="col-sm-8">
                            @(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Member Since:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.CreatedDate.ToString("MMMM dd, yyyy")
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <strong>Last Login:</strong>
                        </div>
                        <div class="col-sm-8">
                            @(Model.LastLoginDate?.ToString("MMMM dd, yyyy 'at' h:mm tt") ?? "Never")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-rocket"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <a asp-controller="Cart" asp-action="OrderHistory" class="btn btn-outline-primary w-100">
                                <i class="fas fa-history"></i> View Order History
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success w-100">
                                <i class="fas fa-shopping-cart"></i> View Shopping Cart
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a asp-controller="Store" asp-action="Index" class="btn btn-outline-info w-100">
                                <i class="fas fa-store"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>