@model ABCRetailers.Models.ShoppingCart
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <h2><i class="fas fa-shopping-cart"></i> Shopping Cart</h2>

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Cart Items (@Model.TotalItems items)</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item row align-items-center mb-3 pb-3 border-bottom">
                                <div class="col-md-6">
                                    <h6>@item.ProductName</h6>
                                    <small class="text-muted">Product ID: @item.ProductId</small>
                                </div>
                                <div class="col-md-2">
                                    <span class="fw-bold text-success">@item.UnitPrice.ToString("C")</span>
                                </div>
                                <div class="col-md-2">
                                    <form method="post" asp-action="UpdateQuantity" class="d-inline">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <input type="number" name="quantity" value="@item.Quantity"
                                               min="1" max="100" class="form-control form-control-sm"
                                               onchange="this.form.submit()" />
                                    </form>
                                </div>
                                <div class="col-md-2">
                                    <span class="fw-bold">@item.TotalPrice.ToString("C")</span>
                                    <form method="post" asp-action="RemoveItem" class="d-inline">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items:</span>
                            <span>@Model.TotalItems</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong class="text-success h5">@Model.TotalPrice.ToString("C")</strong>
                        </div>
                        <a asp-action="CompleteOrder" class="btn btn-success btn-lg">
                            <i class="fas fa-check-circle"></i> Complete Order
                        </a>
                        <a asp-controller="Store" asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-shopping-bag"></i> Continue Shopping
                        </a>
                        <form method="post" asp-action="ClearCart" class="mt-2">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-trash"></i> Clear Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Your shopping cart is empty.
            <a asp-controller="Store" asp-action="Index" class="alert-link">Continue shopping</a>
        </div>
    }
</div>